{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx ng version)",
      "Bash(npx ng build:*)",
      "Bash(npx ng test:*)",
      "Bash(npx ngc -p tsconfig.app.json --noEmit)",
      "PowerShell(npm run build)",
      "PowerShell(npx ngc -p tsconfig.app.json --noEmit)"
    ]
  },
  "enableAllProjectMcpServers": false
}
